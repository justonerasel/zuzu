{
  "entities": {
    "ZuAccount": {
      "title": "ZU-ID Account Identity",
      "description": "Publicly addressable account metadata using custom lowercase username/zu_id key without exposing raw PII or chat data.",
      "type": "object",
      "properties": {
        "zu_id": {
          "type": "string",
          "description": "Normalized canonical ZU-ID lookup key derived from custom alphanumeric username",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,31}$",
          "minLength": 3,
          "maxLength": 32
        },
        "accountId": {
          "type": "string",
          "description": "Canonical ZU-ID alias matching zu_id",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,31}$",
          "minLength": 3,
          "maxLength": 32
        },
        "username": {
          "type": "string",
          "description": "User's chosen custom Username (letters and numbers, optional _ or -)",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,31}$",
          "minLength": 3,
          "maxLength": 32
        },
        "fullName": {
          "type": "string",
          "description": "Display full name",
          "minLength": 1,
          "maxLength": 80
        },
        "phoneMasked": {
          "type": "string",
          "description": "Masked display phone/identifier (no raw PII stored on root document)",
          "minLength": 2,
          "maxLength": 32
        },
        "passwordSalt": {
          "type": "string",
          "description": "Random hex salt for password key derivation",
          "pattern": "^[a-f0-9]+$",
          "minLength": 16,
          "maxLength": 64
        },
        "passwordHash": {
          "type": "string",
          "description": "Salted SHA-256 password digest",
          "pattern": "^[a-f0-9]+$",
          "minLength": 64,
          "maxLength": 128
        },
        "vaultVerifier": {
          "type": "string",
          "description": "SHA-256 hash of ('verify::' + vaultId) used by Firestore Rules to authorize vault access",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "zu_id",
        "accountId",
        "username",
        "fullName",
        "phoneMasked",
        "passwordSalt",
        "passwordHash",
        "vaultVerifier",
        "createdAt",
        "updatedAt"
      ]
    },
    "ZuVault": {
      "title": "ZU-ID Persistent Memory & Backup Vault",
      "description": "Capability-keyed backup containing user phone identifier, chat history, voice sessions, assistant memories, and assistant settings.",
      "type": "object",
      "properties": {
        "zu_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,31}$",
          "minLength": 3,
          "maxLength": 32
        },
        "accountId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,31}$",
          "minLength": 3,
          "maxLength": 32
        },
        "username": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,31}$",
          "minLength": 3,
          "maxLength": 32
        },
        "phone": {
          "type": "string",
          "description": "User phone number or identifier stored strictly inside private vault",
          "minLength": 3,
          "maxLength": 40
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "chatHistory": {
          "type": "array",
          "description": "Persisted text chat messages"
        },
        "voiceSessions": {
          "type": "array",
          "description": "Persisted voice conversation sessions"
        },
        "memories": {
          "type": "array",
          "description": "Persisted Zuzu AI long-term memories"
        },
        "settings": {
          "type": "object",
          "description": "Persisted app settings, voice identity preferences, and wake word configuration"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "zu_id",
        "accountId",
        "username",
        "phone",
        "fullName",
        "chatHistory",
        "voiceSessions",
        "memories",
        "settings",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/zu_accounts/{zuId}": {
      "schema": {
        "$ref": "#/entities/ZuAccount"
      },
      "description": "ZU-ID Account identity lookup document keyed by normalized custom username (zu_id)."
    },
    "/zu_accounts/{zuId}/vault/{vaultId}": {
      "schema": {
        "$ref": "#/entities/ZuVault"
      },
      "description": "Private capability-protected vault storing user PII, chat histories, voice sessions, memories, and settings across uninstall/reinstall."
    }
  }
}
