{
  "entities": {
    "UserProfile": {
      "title": "Authenticated Zuzu AI User Profile",
      "description": "Firebase Auth UID-scoped user profile storing displayName, verified email/phone, avatar data, and linked authentication providers.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 40
        },
        "photoData": {
          "type": "string",
          "maxLength": 200000
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "providers", "createdAt", "updatedAt"]
    },
    "UserVault": {
      "title": "UID-Isolated Private Assistant Vault",
      "description": "Private user vault keyed by Firebase Auth UID containing isolated chat history, voice sessions, long-term memories, notebook notes, reminders, uploaded file metadata, and assistant settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128
        },
        "chatHistory": {
          "type": "array"
        },
        "voiceSessions": {
          "type": "array"
        },
        "memories": {
          "type": "array"
        },
        "notes": {
          "type": "array"
        },
        "reminders": {
          "type": "array"
        },
        "uploadedFiles": {
          "type": "array"
        },
        "settings": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "chatHistory",
        "voiceSessions",
        "memories",
        "notes",
        "reminders",
        "settings",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Authenticated user profile strictly readable/writable by request.auth.uid == userId."
    },
    "/users/{userId}/vault/{vaultId}": {
      "schema": {
        "$ref": "#/entities/UserVault"
      },
      "description": "Private per-UID assistant vault strictly readable/writable by request.auth.uid == userId."
    }
  }
}
