rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Identity & Schema Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUid(id) {
      return id is string && id.size() >= 6 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'providers', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phoneNumber', 'photoData', 'providers', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40))
        && (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 200000))
        && data.providers is list && data.providers.size() >= 1 && data.providers.size() <= 10 && data.providers[0] is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserVault(data, userId) {
      return data.keys().hasAll([
          'uid', 'chatHistory', 'voiceSessions', 'memories', 'notes', 'reminders', 'settings', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'chatHistory', 'voiceSessions', 'memories', 'notes', 'reminders', 'uploadedFiles', 'settings', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId
        && data.chatHistory is list && data.chatHistory.size() <= 500 && (data.chatHistory.size() == 0 || data.chatHistory[0] is map)
        && data.voiceSessions is list && data.voiceSessions.size() <= 200 && (data.voiceSessions.size() == 0 || data.voiceSessions[0] is map)
        && data.memories is list && data.memories.size() <= 300 && (data.memories.size() == 0 || data.memories[0] is map)
        && data.notes is list && data.notes.size() <= 200 && (data.notes.size() == 0 || data.notes[0] is map)
        && data.reminders is list && data.reminders.size() <= 200 && (data.reminders.size() == 0 || data.reminders[0] is map)
        && (!('uploadedFiles' in data) || (data.uploadedFiles is list && data.uploadedFiles.size() <= 100 && (data.uploadedFiles.size() == 0 || data.uploadedFiles[0] is map)))
        && data.settings is map && data.settings.keys().size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 3. Authenticated User Profile (UID-strict; zero enumeration; zero cross-user read)
    match /users/{userId} {
      allow list: if false;
      allow get: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidUid(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/users/$(userId));

      allow update: if isOwner(userId)
        && isValidUid(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'photoData', 'providers', 'updatedAt'
        ]);

      allow delete: if isOwner(userId);

      // 4. UID-Isolated Private Data Vault (chatHistory, voiceSessions, memories, notes, reminders, uploadedFiles, settings)
      match /vault/{vaultId} {
        allow list: if false;
        allow get: if isOwner(userId) && vaultId == 'primary';

        allow create: if isOwner(userId)
          && isValidUid(userId)
          && vaultId == 'primary'
          && isValidUserVault(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isOwner(userId)
          && isValidUid(userId)
          && vaultId == 'primary'
          && isValidUserVault(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'chatHistory', 'voiceSessions', 'memories', 'notes', 'reminders', 'uploadedFiles', 'settings', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && vaultId == 'primary';
      }
    }

    // 5. Legacy ZU-ID collection locked down after Firebase Auth migration
    match /zu_accounts/{zuId} {
      allow read, write: if false;
    }
  }
}
