rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Validation Helpers
    function isValidNusuId(id) {
      return id is string && id.size() == 9 && id.matches('^NU-[0-9]{6}$');
    }

    function isValidVaultId(id) {
      return id is string && id.size() == 64 && id.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidNusuAccount(data, nusuId) {
      return data.keys().hasAll([
          'accountId', 'fullName', 'phoneMasked',
          'passwordSalt', 'passwordHash', 'vaultVerifier',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'accountId', 'fullName', 'phoneMasked',
          'passwordSalt', 'passwordHash', 'vaultVerifier',
          'createdAt', 'updatedAt'
        ])
        && data.accountId is string && data.accountId == nusuId
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80
        && data.phoneMasked is string && data.phoneMasked.size() >= 2 && data.phoneMasked.size() <= 32
        && data.passwordSalt is string && data.passwordSalt.size() >= 16 && data.passwordSalt.size() <= 64 && data.passwordSalt.matches('^[a-f0-9]+$')
        && data.passwordHash is string && data.passwordHash.size() >= 64 && data.passwordHash.size() <= 128 && data.passwordHash.matches('^[a-f0-9]+$')
        && data.vaultVerifier is string && data.vaultVerifier.size() == 64 && data.vaultVerifier.matches('^[a-f0-9]{64}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVault(data, nusuId) {
      return data.keys().hasAll([
          'accountId', 'phone', 'fullName',
          'chatHistory', 'voiceSessions', 'memories', 'settings',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'accountId', 'phone', 'fullName',
          'chatHistory', 'voiceSessions', 'memories', 'settings',
          'createdAt', 'updatedAt'
        ])
        && data.accountId is string && data.accountId == nusuId
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 40
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80
        && data.chatHistory is list && data.chatHistory.size() <= 500 && (data.chatHistory.size() == 0 || data.chatHistory[0] is map)
        && data.voiceSessions is list && data.voiceSessions.size() <= 200 && (data.voiceSessions.size() == 0 || data.voiceSessions[0] is map)
        && data.memories is list && data.memories.size() <= 300 && (data.memories.size() == 0 || data.memories[0] is map)
        && data.settings is map && data.settings.keys().size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidVaultCapability(nusuId, vaultId) {
      return exists(/databases/$(database)/documents/nusu_accounts/$(nusuId))
        && hashing.sha256(('verify::' + vaultId).toUtf8()).toHexString().lower()
           == get(/databases/$(database)/documents/nusu_accounts/$(nusuId)).data.vaultVerifier;
    }

    // 3. NUSU Account Identity Lookup (Zero list access; point-get only; no PII/chats)
    match /nusu_accounts/{nusuId} {
      allow list: if false;
      allow get: if isValidNusuId(nusuId);

      allow create: if isValidNusuId(nusuId)
        && isValidNusuAccount(incoming(), nusuId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/nusu_accounts/$(nusuId));

      allow update: if isValidNusuId(nusuId)
        && isValidNusuAccount(incoming(), nusuId)
        && incoming().accountId == existing().accountId
        && incoming().createdAt == existing().createdAt
        && incoming().passwordSalt == existing().passwordSalt
        && incoming().passwordHash == existing().passwordHash
        && incoming().vaultVerifier == existing().vaultVerifier
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phoneMasked', 'updatedAt']);

      allow delete: if false;

      // 4. Private Password-Capability Protected Backup Vault
      match /vault/{vaultId} {
        allow list: if false;
        allow get: if isValidNusuId(nusuId)
          && isValidVaultId(vaultId)
          && hasValidVaultCapability(nusuId, vaultId);

        allow create: if isValidNusuId(nusuId)
          && isValidVaultId(vaultId)
          && isValidVault(incoming(), nusuId)
          && hasValidVaultCapability(nusuId, vaultId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidNusuId(nusuId)
          && isValidVaultId(vaultId)
          && isValidVault(incoming(), nusuId)
          && hasValidVaultCapability(nusuId, vaultId)
          && incoming().accountId == existing().accountId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'phone', 'fullName', 'chatHistory', 'voiceSessions', 'memories', 'settings', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }
  }
}
