rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Validation Helpers
    function isValidSuId(id) {
      return id is string && id.size() >= 3 && id.size() <= 32 && id.matches('^[a-z0-9][a-z0-9_\\-]{2,31}$');
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 32 && name.matches('^[a-zA-Z0-9][a-zA-Z0-9_\\-]{2,31}$');
    }

    function isValidVaultId(id) {
      return id is string && id.size() == 64 && id.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSuAccount(data, suId) {
      return data.keys().hasAll([
          'accountId', 'username', 'fullName', 'phoneMasked',
          'passwordSalt', 'passwordHash', 'vaultVerifier',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'accountId', 'username', 'fullName', 'phoneMasked',
          'passwordSalt', 'passwordHash', 'vaultVerifier',
          'createdAt', 'updatedAt'
        ])
        && data.accountId is string && data.accountId == suId
        && isValidUsername(data.username) && data.username.lower() == suId
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80
        && data.phoneMasked is string && data.phoneMasked.size() >= 2 && data.phoneMasked.size() <= 32
        && data.passwordSalt is string && data.passwordSalt.size() >= 16 && data.passwordSalt.size() <= 64 && data.passwordSalt.matches('^[a-f0-9]+$')
        && data.passwordHash is string && data.passwordHash.size() >= 64 && data.passwordHash.size() <= 128 && data.passwordHash.matches('^[a-f0-9]+$')
        && data.vaultVerifier is string && data.vaultVerifier.size() == 64 && data.vaultVerifier.matches('^[a-f0-9]{64}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSuVault(data, suId) {
      return data.keys().hasAll([
          'accountId', 'username', 'phone', 'fullName',
          'chatHistory', 'voiceSessions', 'memories', 'settings',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'accountId', 'username', 'phone', 'fullName',
          'chatHistory', 'voiceSessions', 'memories', 'settings',
          'createdAt', 'updatedAt'
        ])
        && data.accountId is string && data.accountId == suId
        && isValidUsername(data.username) && data.username.lower() == suId
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 40
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80
        && data.chatHistory is list && data.chatHistory.size() <= 500 && (data.chatHistory.size() == 0 || data.chatHistory[0] is map)
        && data.voiceSessions is list && data.voiceSessions.size() <= 200 && (data.voiceSessions.size() == 0 || data.voiceSessions[0] is map)
        && data.memories is list && data.memories.size() <= 300 && (data.memories.size() == 0 || data.memories[0] is map)
        && data.settings is map && data.settings.keys().size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidVaultCapability(suId, vaultId) {
      return exists(/databases/$(database)/documents/su_accounts/$(suId))
        && hashing.sha256(('verify::' + vaultId).toUtf8()).toHexString().lower()
           == get(/databases/$(database)/documents/su_accounts/$(suId)).data.vaultVerifier;
    }

    // 3. SU-ID Custom Username Identity Lookup (Zero list access; point-get only; no PII/chats)
    match /su_accounts/{suId} {
      allow list: if false;
      allow get: if isValidSuId(suId);

      allow create: if isValidSuId(suId)
        && isValidSuAccount(incoming(), suId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/su_accounts/$(suId));

      allow update: if isValidSuId(suId)
        && isValidSuAccount(incoming(), suId)
        && incoming().accountId == existing().accountId
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().passwordSalt == existing().passwordSalt
        && incoming().passwordHash == existing().passwordHash
        && incoming().vaultVerifier == existing().vaultVerifier
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phoneMasked', 'updatedAt']);

      allow delete: if false;

      // 4. Private Password-Capability Protected Backup Vault
      match /vault/{vaultId} {
        allow list: if false;
        allow get: if isValidSuId(suId)
          && isValidVaultId(vaultId)
          && hasValidVaultCapability(suId, vaultId);

        allow create: if isValidSuId(suId)
          && isValidVaultId(vaultId)
          && isValidSuVault(incoming(), suId)
          && hasValidVaultCapability(suId, vaultId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidSuId(suId)
          && isValidVaultId(vaultId)
          && isValidSuVault(incoming(), suId)
          && hasValidVaultCapability(suId, vaultId)
          && incoming().accountId == existing().accountId
          && incoming().username == existing().username
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'phone', 'fullName', 'chatHistory', 'voiceSessions', 'memories', 'settings', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }
  }
}
